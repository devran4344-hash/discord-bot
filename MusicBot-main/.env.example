# ─────────────────────────────────────────────────────────────────────────────
#  .env.example  —  Copy this to .env for local development
#  For production (GitHub Actions), set all of these as GitHub Secrets.
#  .env is in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=                          # Leave blank for global commands

# ── Spotify ───────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ── Genius (Lyrics) ───────────────────────────────────────────────────────────
GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=

# ── YouTube auth (optional — helps bypass bot detection on VPS IPs) ───────────
YOUTUBE_PO_TOKEN=
COOKIES_FROM_BROWSER=chrome       # chrome | firefox | edge  (leave blank on server)
COOKIES_FILE=                      # path to cookies.txt

# ── Bot settings ─────────────────────────────────────────────────────────────
BOT_STATUS=🎵 Music | /play
SUPPORT_SERVER=https://discord.gg/example
WEBSITE=https://example.com

DEFAULT_VOLUME=80
MAX_QUEUE_SIZE=200
MAX_PLAYLIST_SIZE=100
AUDIO_BITRATE=128

# ── Embed colours (hex, optional — defaults are brand colours) ────────────────
EMBED_COLOR=#5865F2
COLOR_YOUTUBE=#FF0000
COLOR_SPOTIFY=#1DB954
COLOR_SOUNDCLOUD=#FF5500
COLOR_DIRECT=#5865F2
COLOR_SUCCESS=#57F287
COLOR_ERROR=#ED4245
COLOR_WARNING=#FEE75C
COLOR_INFO=#5865F2
COLOR_QUEUE=#EB459E

# ── Sharding (optional) ───────────────────────────────────────────────────────
TOTAL_SHARDS=auto
SHARD_MODE=process
SHARD_RESPAWN=true
