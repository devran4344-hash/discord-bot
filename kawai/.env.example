# Discord Bot Token (GitHub Secrets: KAWAI_TOKEN)
DISCORD_TOKEN=buraya_kawai_token

# Discord Application ID (GitHub Secrets: KAWAI_CLIENT_ID)
CLIENT_ID=buraya_client_id

# NVIDIA NIM API Key (GitHub Secrets: KAWAI_NVIDIA_API_KEY)
KAWAI_NVIDIA_API_KEY=buraya_nvidia_key

# OpenAI API Key - sadece DALL-E icin (GitHub Secrets: KAWAI_OPENAI_API_KEY)
KAWAI_OPENAI_API_KEY=buraya_openai_key

# Firebase Service Account (Base64) (GitHub Secrets: FIREBASE_SERVICE_ACCOUNT_B64)
FIREBASE_SERVICE_ACCOUNT_B64=buraya_base64_firebase

# Owner Discord ID leri (virgulle ayir)
KAWAI_OWNER_IDS=123456789,987654321
